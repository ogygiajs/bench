{
	"name": "@bench/abax",
	"private": true,
	"description": "Deterministic function-level benchmark engine: counts steps, allocations and calls per function, block and line.",
	"license": "MIT",
	"bin": {
		"abax": "./src/cli.ts"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./bench": "./src/bench.ts",
		"./runtime": "./src/runtime/index.ts",
		"./transform": "./src/transform/index.ts",
		"./plugin": "./src/plugin.ts",
		"./register": "./src/loader/register.ts",
		"./hooks": "./src/loader/hooks.ts",
		"./report": "./src/report.ts",
		"./diff": "./src/diff/index.ts",
		"./dts": "./src/dts.ts",
		"./prices.json": "./prices.json"
	},
	"scripts": {
		"test": "node --test --test-concurrency=1 \"test/*.test.ts\"",
		"slowdown": "node scripts/slowdown.ts"
	},
	"dependencies": {
		"@bench/compare": "workspace:*",
		"@jridgewell/remapping": "2.3.5",
		"@jridgewell/trace-mapping": "0.3.31",
		"magic-string": "1.4.5",
		"oxc-parser": "0.157.0",
		"tinybench": "catalog:measure"
	},
	"devDependencies": {
		"@types/node": "26.1.2",
		"devalue": "5.9.4",
		"rolldown": "catalog:",
		"svelte": "5.57.3",
		"typescript": "6.0.3"
	},
	"peerDependencies": {
		"svelte": ">=5.0.0",
		"typescript": ">=5.0.0"
	},
	"peerDependenciesMeta": {
		"svelte": {
			"optional": true
		},
		"typescript": {
			"optional": true
		}
	}
}
