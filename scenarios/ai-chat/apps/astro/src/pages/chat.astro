---
// The markup of the shared ChatPage.svelte: the history as static HTML, the composer and the
// replies of this visit as one island, awake from the start.
import messages from '../shared/data/history.json';
import History from '../shared/components/History.svelte';
import Chat from '../shared/components/Chat.svelte';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="stylesheet" href="/chat.css" />
		<title>Assistant · Bench Chat</title>
	</head>
	<body>
		<div class="chat-app">
			<header class="chat-head">
				<h1>Assistant</h1>
				<p>{messages.length} messages</p>
			</header>
			<main class="thread">
				<History messages={messages} />
				<Chat client:load start={messages.length / 2} />
			</main>
		</div>
	</body>
</html>
