{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"printWidth": 100,
	"trailingComma": "none",
	"overrides": [
		{
			"files": ["**/*.md"],
			"options": { "embeddedLanguageFormatting": "off" }
		}
	],
	"ignorePatterns": [
		"**/dist/**",
		"**/build/**",
		"packages/heisenbench/test/fixtures/traffic/bundle/**",
		"**/.svelte-kit/**",
		"**/.astro/**",
		"**/.mochi/**",
		"pnpm-lock.yaml",
		"packages/heisenbench/calibration/data/training-*.json",
		"packages/heisenbench/ranges.json",
		"packages/heisenbench/calibration/ranges.md",
		"suites/apps/frameworks/**",
		"suites/apps/scenarios/*/apps/**",
		"suites/apps/scenarios/*/shared/**",
		"suites/apps/shared/**",
		"suites/apps/posts/**",
		"suites/apps/results/**"
	]
}
